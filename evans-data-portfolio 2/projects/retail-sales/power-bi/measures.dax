Transactions = DISTINCTCOUNT(Sales[transaction_id])

Completed Transactions =
    CALCULATE([Transactions], Sales[status] = "Completed")

Returned Transactions =
    CALCULATE([Transactions], Sales[status] = "Returned")

Net Revenue = SUM(Sales[net_revenue_ngn])

Cost of Goods = SUM(Sales[cogs_ngn])

Gross Profit = SUM(Sales[gross_profit_ngn])

Gross Margin = DIVIDE([Gross Profit], [Net Revenue])

Return Rate = DIVIDE([Returned Transactions], [Transactions])

Average Completed Order Value =
    DIVIDE([Net Revenue], [Completed Transactions])

Previous Month Revenue =
    CALCULATE(
        [Net Revenue],
        DATEADD('Calendar'[Date], -1, MONTH)
    )

Month on Month Growth =
    DIVIDE(
        [Net Revenue] - [Previous Month Revenue],
        [Previous Month Revenue]
    )
